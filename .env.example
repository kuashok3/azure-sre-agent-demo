# Copy to .env for LOCAL development only. Never commit .env.
# Every variable is documented in docs/CONFIGURATION.md.

ENVIRONMENT=local
LOG_LEVEL=INFO

# PostgreSQL (docker compose publishes it on host port 5434)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=orders
DB_USER=orders
DB_PASSWORD=local-dev-only-password
DB_SSLMODE=disable
DB_AUTH_MODE=password

# Downstream payment service
PAYMENT_BASE_URL=http://localhost:8081
PAYMENT_TIMEOUT_SECONDS=2

# Controlled failure injection (demo only). Token must be >= 16 characters.
FAULTS_ENABLED=true
FAULT_ADMIN_TOKEN=change-me-local-fault-token

# Leave empty locally. In Azure this comes from Application Insights.
APPLICATIONINSIGHTS_CONNECTION_STRING=
