// Runbook DATABASE_FAILURE: PostgreSQL calls, failures and p95 per 5 minutes.
let lookback = 1h;
AppDependencies
| where TimeGenerated > ago(lookback) and AppRoleName == 'orders-api' and DependencyType == 'postgresql'
| summarize calls = sum(ItemCount), failed = sumif(ItemCount, Success == false), p95_ms = percentile(DurationMs, 95)
    by bin(TimeGenerated, 5m)
| order by TimeGenerated asc
